    },
    {
      "name": "Passo 4–5 · Timeout",
      "item": [
        {
          "name": "Débito lento (DEBIT_SLOW)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Simulate",
                "value": "DEBIT_SLOW"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transferUrl}}/transfers",
            "description": "Passo 4: o timeout estorna um débito que deu certo. Passo 5+: DEBIT_UNKNOWN, reenvio com a mesma chave, COMPLETED sem estorno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{from}}\",\n  \"to\": \"henrique\",\n  \"amount\": 150.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda o id da transferência criada: as próximas requisições usam {{transferId}}.",
                  "const body = pm.response.json();",
                  "const id = body.id ?? body.transferId;",
                  "if (id) { pm.collectionVariables.set('transferId', id); console.log('transferId =', id); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Passo 5–6 · Retry, DLT e circuit breaker",
      "item": [
        {
          "name": "Pix quebrado (PIX_CRASH)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Simulate",
                "value": "PIX_CRASH"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transferUrl}}/transfers",
            "description": "Passo 5: a mensagem some e a saga fica em PIX_PENDING. Passo 6+: retry 1/2/4 s → pix.commands.DLT → NEEDS_ATTENTION (~40 s).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{from}}\",\n  \"to\": \"henrique\",\n  \"amount\": 150.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda o id da transferência criada: as próximas requisições usam {{transferId}}.",
                  "const body = pm.response.json();",
                  "const id = body.id ?? body.transferId;",
                  "if (id) { pm.collectionVariables.set('transferId', id); console.log('transferId =', id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Derrubar o SPI por 15 s",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{pixUrl}}/spi/outage?seconds=15",
            "description": "Passo 6+. Depois crie uma transferência: o circuito abre e o consumidor pausa."
          }
        },
        {
          "name": "Estado do SPI e do circuito",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{pixUrl}}/spi",
            "description": "CLOSED → OPEN → HALF_OPEN → CLOSED."
          }
        },
        {
          "name": "SPI de volta na hora",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{pixUrl}}/spi/outage",
            "description": ""
          }
        }
      ]
    },
    {
