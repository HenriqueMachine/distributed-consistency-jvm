          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda o id da mensagem morta mais recente: o resgate usa {{deadLetterId}}.",
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list.length) { pm.collectionVariables.set('deadLetterId', list[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mensagens mortas ainda não resgatadas",
          "request": {
